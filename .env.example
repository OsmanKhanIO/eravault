# ==============================================================================
# ERAVAULT - ENVIRONMENT VARIABLES CONFIGURATION
# 
# INSTRUCTIONS:
# 1. Copy this file and rename it to ".env.local" in the root directory.
# 2. Replace the placeholder values below with your actual API keys.
# 3. NEVER commit your ".env.local" file to Git or public repositories.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION
# Setup: https://dashboard.clerk.com -> Applications -> API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY

# Clerk Routing Rules (Leave these defaults unchanged for Next.js App Router)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard


# ------------------------------------------------------------------------------
# 2. NEON POSTGRES DATABASE
# Setup: https://neon.tech -> Create Project -> Connection Details -> Postgres
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@ep-example-host.region.aws.neon.tech/eravault?sslmode=require"


# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (Computer Vision & Tagging Engine)
# Setup: https://aistudio.google.com -> Get API Key -> Create API Key
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY_HERE"


# ------------------------------------------------------------------------------
# 4. IMGBB STORAGE (Direct Image Delivery & Hosting)
# Setup: https://api.imgbb.com -> Sign In -> Add API Key
# ------------------------------------------------------------------------------
NEXT_PUBLIC_IMGBB_API_KEY="your_imgbb_32_character_api_key"
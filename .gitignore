# ── See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.js

# ── Testing ─────────────────────────────────────────────────────────
/coverage

# ── Next.js / Build Output ──────────────────────────────────────────
/.next/
/out/
/build
/dist

# ── Cloudflare Pages & Wrangler ─────────────────────────────────────
/.vercel
/.wrangler
/.dev.vars

# ── Prisma & Database ───────────────────────────────────────────────
/src/generated/prisma
/prisma/migrations/*.tmp
*.db
*.db-journal

# ── Production & Environment Secrets ────────────────────────────────
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# ── Vercel / Cloud Engine Artifacts ─────────────────────────────────
.vercel

# ── TypeScript & Debug Logs ─────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tsbuildinfo
next-env.d.ts

# ── OS & Editor Metadata ────────────────────────────────────────────
.DS_Store
*.pem
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?